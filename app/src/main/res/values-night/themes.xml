<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.Food" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->

        <item name="colorPrimary">@color/gray_dark</item>
        <item name="colorPrimaryVariant">@color/black_2</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/blue</item>
        <item name="colorSecondaryVariant">@color/blue</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="fontFamily">@font/vazir_medium_fn</item>

        <item name="colorSurface">@color/gray_dark</item>
        <item name="colorOutline">@color/orange</item>
        <item name="colorOnBackground">@color/back2</item>

        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

    <style name="MyToolBar" parent="Widget.Material3.Toolbar">

        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/orange_dark</item>
        <item name="colorOnSurface">@color/white</item>

        <item name="colorControlNormal">@color/orange_dark</item>

    </style>

    <style name="MyText" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorOnPrimary">@color/white</item>
        <item name="fontFamily">@font/dana_medium</item>

    </style>

</resources>